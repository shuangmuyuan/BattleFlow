{
  "name": "battleflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "bash ./scripts/build.sh",
    "dev": "bash ./scripts/dev.sh",
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint",
    "lint:build": "eslint . --quiet",
    "start": "bash ./scripts/start.sh",
    "test": "vitest run --dir src",
    "test:watch": "vitest --dir src",
    "ts-check": "tsc -p tsconfig.json",
    "check:overlays": "node scripts/check-overlay-bounds.mjs",
    "check:responsive": "node scripts/check-responsive-layout.mjs",
    "db:knowledge:init": "node scripts/apply-postgres-migration.mjs scripts/database/001_knowledge_store.sql",
    "db:accounts:init": "node scripts/apply-postgres-migration.mjs scripts/database/002_account_org_permissions.sql",
    "db:sso:init": "node scripts/apply-postgres-migration.mjs scripts/database/002_sso_users.sql",
    "db:notifications:init": "node scripts/apply-postgres-migration.mjs scripts/database/004_notifications.sql",
    "db:chat-runs:init": "node scripts/apply-postgres-migration.mjs scripts/database/006_chat_runs.sql",
    "db:planning-surfaces:cleanup": "node scripts/apply-postgres-migration.mjs scripts/database/007_remove_unused_planning_surfaces.sql",
    "db:resources:migrate": "node scripts/migrate-resource-metadata.mjs",
    "db:skills:cleanup-seeds": "node scripts/cleanup-official-seed-skills.mjs",
    "db:postgres:init": "pnpm db:knowledge:init && pnpm db:accounts:init && pnpm db:sso:init && pnpm db:notifications:init && pnpm db:chat-runs:init && pnpm db:planning-surfaces:cleanup",
    "validate": "pnpm run --parallel '/^(ts-check|lint:build|check:overlays|check:responsive)$/'"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.202",
    "@assistant-ui/react": "^0.14.26",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "opencc-js": "^1.4.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "read-excel-file": "^9.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.11",
    "word-extractor": "^1.0.4",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "only-allow": "^1.2.2",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "write-excel-file": "^4.1.1"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "pnpm": ">=9.0.0"
  }
}
